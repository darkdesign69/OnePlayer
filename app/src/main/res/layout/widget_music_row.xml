<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/w_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/wg_bg_default" />

  <LinearLayout
      android:id="@+id/w_content"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="6dp"
      android:paddingTop="6dp"
      android:paddingEnd="8dp"
      android:paddingBottom="6dp">
    <ImageView
        android:id="@+id/w_note"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/w_art"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/music_widget_open"
        android:scaleType="fitCenter" />
    <LinearLayout
        android:id="@+id/w_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
      <LinearLayout
          android:id="@+id/w_title_area"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginEnd="22dp"
          android:gravity="start"
          android:orientation="vertical">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="OnlyPlay"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Tap play to start music"
            android:textColor="#FFB9C4E8"
            android:textSize="12sp" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/w_progress_row"
          android:layout_width="match_parent"
          android:layout_height="14dp"
          android:layout_marginTop="2dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
        <TextView
            android:id="@+id/w_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0:00"
            android:textColor="#FFC9D2F0"
            android:textSize="10sp" />
        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
        <TextView
            android:id="@+id/w_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0:00"
            android:textColor="#FFC9D2F0"
            android:textSize="10sp" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/w_buttons"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/w_shuffle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="@string/music_widget_shuffle">
          <ImageView
              android:id="@+id/w_shuffle_icon"
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center"
              android:src="@drawable/wg_shuffle" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_prev"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="@string/music_widget_prev">
          <ImageView
              android:id="@+id/w_prev_icon"
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_gravity="center"
              android:src="@drawable/wg_prev" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_play"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.4"
            android:contentDescription="@string/music_widget_play_pause">
          <ImageView
              android:id="@+id/w_play_icon"
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:layout_gravity="center"
              android:background="@drawable/wg_play_circle"
              android:padding="10dp"
              android:src="@drawable/wg_play" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_next"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="@string/music_widget_next">
          <ImageView
              android:id="@+id/w_next_icon"
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_gravity="center"
              android:src="@drawable/wg_next" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_repeat"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="@string/music_widget_repeat">
          <ImageView
              android:id="@+id/w_repeat_icon"
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center"
              android:src="@drawable/wg_repeat_off" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_fav"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="@string/music_widget_favourite">
          <ImageView
              android:id="@+id/w_fav_icon"
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center"
              android:src="@drawable/wg_fav" />
        </FrameLayout>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <FrameLayout
      android:id="@+id/w_ov_fav"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_gravity="top|end"
      android:contentDescription="@string/music_widget_favourite">
    <ImageView
        android:id="@+id/w_ov_fav_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:padding="5dp"
        android:src="@drawable/wg_fav" />
  </FrameLayout>
</FrameLayout>
