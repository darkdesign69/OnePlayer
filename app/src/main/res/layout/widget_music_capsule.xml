<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/mw_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/mw_bg_default" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingTop="3dp"
      android:paddingEnd="12dp"
      android:paddingBottom="3dp">
    <ImageView
        android:id="@+id/mw_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitXY"
        android:src="@drawable/mw_art_default"
        android:contentDescription="@string/music_widget_open" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:id="@+id/mw_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:text="One Player"
          android:textColor="#FFFFFFFF"
          android:textSize="14sp"
          android:textStyle="normal" />
      <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:gravity="center"
      android:orientation="horizontal">
      <FrameLayout
          android:id="@+id/mw_shuffle"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_shuffle">
        <ImageView
            android:id="@+id/mw_shuffle_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_shuffle" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/mw_prev"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_prev">
        <ImageView
            android:id="@+id/mw_prev_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_prev" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/mw_play"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1.3"
          android:contentDescription="@string/music_widget_play_pause">
        <ImageView
            android:id="@+id/mw_play_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_play" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/mw_next"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_next">
        <ImageView
            android:id="@+id/mw_next_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_next" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/mw_repeat"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_repeat">
        <ImageView
            android:id="@+id/mw_repeat_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_repeat" />
      </FrameLayout>
    </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
