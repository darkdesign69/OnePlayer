<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/w_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/wg_bg_default" />

  <LinearLayout
      android:id="@+id/w_content"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <ImageView
        android:id="@+id/w_art"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_margin="7dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/music_widget_open"
        android:maxWidth="120dp"
        android:scaleType="centerCrop" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="12dp">
    <LinearLayout
        android:id="@+id/w_title_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">
      <TextView
          android:id="@+id/w_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="start"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:text="OnlyPlay"
          android:textColor="#FFFFFFFF"
          android:textSize="14sp"
          android:textStyle="bold" />
      <TextView
          android:id="@+id/w_artist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="start"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:text="Tap play to start music"
          android:textColor="#FFB9B6C8"
          android:textSize="12sp"
          android:textStyle="normal" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="1dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />
    <LinearLayout
        android:id="@+id/w_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
      <FrameLayout
          android:id="@+id/w_shuffle"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_shuffle">
        <ImageView
            android:id="@+id/w_shuffle_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/wg_shuffle" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/w_prev"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_prev">
        <ImageView
            android:id="@+id/w_prev_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/wg_prev" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/w_play"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_play_pause">
        <ImageView
            android:id="@+id/w_play_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/wg_play" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/w_next"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_next">
        <ImageView
            android:id="@+id/w_next_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/wg_next" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/w_repeat"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_repeat">
        <ImageView
            android:id="@+id/w_repeat_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/wg_repeat_off" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/w_fav"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_favourite">
        <ImageView
            android:id="@+id/w_fav_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/wg_fav" />
      </FrameLayout>
    </LinearLayout>
      </LinearLayout>
  </LinearLayout>

</FrameLayout>
