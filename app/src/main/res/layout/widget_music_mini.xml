<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/mw_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/mw_bg_default" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingStart="8dp"
      android:paddingTop="4dp"
      android:paddingEnd="8dp"
      android:paddingBottom="4dp">
    <LinearLayout
        android:id="@+id/mw_title_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
      <TextView
          android:id="@+id/mw_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:text="One Player"
          android:textColor="#FFFFFFFF"
          android:textSize="15sp"
          android:textStyle="bold" />
      <TextView
          android:id="@+id/mw_artist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:text="Tap play to start music"
          android:textColor="#CCFFFFFF"
          android:textSize="12sp"
          android:textStyle="normal" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:gravity="center"
      android:orientation="horizontal">
      <FrameLayout
          android:id="@+id/mw_repeat"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_repeat">
        <ImageView
            android:id="@+id/mw_repeat_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_repeat" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/mw_prev"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_prev">
        <ImageView
            android:id="@+id/mw_prev_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_prev" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/mw_play"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1.2"
          android:contentDescription="@string/music_widget_play_pause">
        <ImageView
            android:id="@+id/mw_play_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_pause" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/mw_next"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_next">
        <ImageView
            android:id="@+id/mw_next_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_next" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/mw_fav"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_favourite">
        <ImageView
            android:id="@+id/mw_fav_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/mw_heart" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>

  <ProgressBar
      android:id="@+id/mw_line"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="3dp"
      android:layout_gravity="bottom"
      android:layout_marginStart="14dp"
      android:layout_marginEnd="14dp"
      android:layout_marginBottom="5dp"
      android:max="1000"
      android:progress="0"
      android:progressDrawable="@drawable/widget_progress" />
</FrameLayout>
