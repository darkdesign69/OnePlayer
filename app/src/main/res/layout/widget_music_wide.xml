<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/widget_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/widget_bg_default" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="6dp">
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/music_widget_open" />
    <LinearLayout
        android:id="@+id/widget_title_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:id="@+id/widget_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:text="One Player"
          android:textColor="#FFFFFFFF"
          android:textSize="13sp"
          android:textStyle="bold" />
      <TextView
          android:id="@+id/widget_artist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:text="Tap play to start music"
          android:textColor="#FFB4AEFF"
          android:textSize="11sp"
          android:textStyle="normal" />
      <LinearLayout
        android:id="@+id/widget_progress_row"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/widget_elapsed"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:text="0:00"
          android:textColor="#DDFFFFFF"
          android:textSize="10sp" />
      <ProgressBar
          android:id="@+id/widget_progress"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="0dp"
          android:layout_height="5dp"
          android:layout_marginStart="6dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:max="1000"
          android:progress="0"
          android:progressDrawable="@drawable/widget_progress" />
      <TextView
          android:id="@+id/widget_total"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:text="0:00"
          android:textColor="#DDFFFFFF"
          android:textSize="10sp" />
    </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <FrameLayout
          android:id="@+id/widget_repeat"
          android:layout_width="36dp"
          android:layout_height="52dp"
          android:contentDescription="@string/music_widget_repeat">
        <ImageView
            android:id="@+id/widget_repeat_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_repeat_off" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/widget_fav"
          android:layout_width="36dp"
          android:layout_height="52dp"
          android:contentDescription="@string/music_widget_favourite">
        <ImageView
            android:id="@+id/widget_fav_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_fav" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/widget_prev"
          android:layout_width="38dp"
          android:layout_height="52dp"
          android:contentDescription="@string/music_widget_prev">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_prev" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/widget_play"
          android:layout_width="48dp"
          android:layout_height="52dp"
          android:contentDescription="@string/music_widget_play_pause">
        <ImageView
            android:id="@+id/widget_play_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_play_bg"
            android:padding="10dp"
            android:src="@drawable/widget_ic_play" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/widget_next"
          android:layout_width="38dp"
          android:layout_height="52dp"
          android:contentDescription="@string/music_widget_next">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_next" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
