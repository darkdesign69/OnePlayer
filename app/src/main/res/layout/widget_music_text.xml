<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/widget_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/widget_bg_default" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="10dp"
      android:paddingTop="3dp"
      android:paddingEnd="10dp"
      android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/widget_title_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:textStyle="normal" />
      </LinearLayout>
      <ImageView
          android:id="@+id/widget_brand"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:layout_marginStart="4dp"
          android:src="@drawable/widget_ic_note" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/widget_prev"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_widget_prev">
          <ImageView
              android:layout_width="26dp"
              android:layout_height="26dp"
              android:layout_gravity="center"
              android:src="@drawable/widget_ic_prev" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_play"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_widget_play_pause">
          <ImageView
              android:id="@+id/widget_play_icon"
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:layout_gravity="center"
              android:background="@drawable/widget_play_bg"
              android:padding="8dp"
              android:src="@drawable/widget_ic_play" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_next"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_widget_next">
          <ImageView
              android:layout_width="26dp"
              android:layout_height="26dp"
              android:layout_gravity="center"
              android:src="@drawable/widget_ic_next" />
        </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
