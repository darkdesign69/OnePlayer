<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/widget_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/widget_bg_default" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingStart="6dp"
      android:paddingTop="6dp"
      android:paddingEnd="6dp"
      android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/music_widget_open"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/widget_title_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="vertical">
      <TextView
          android:id="@+id/widget_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:textColor="#FFFFFFFF"
          android:textSize="12sp"
          android:textStyle="bold" />
      <TextView
          android:id="@+id/widget_artist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:singleLine="true"
          android:textColor="#CCFFFFFF"
          android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">
      <FrameLayout
          android:id="@+id/widget_prev"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_prev">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_prev" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/widget_play"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1.2"
          android:contentDescription="@string/music_widget_play_pause">
        <ImageView
            android:id="@+id/widget_play_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_play_bg"
            android:padding="9dp"
            android:src="@drawable/widget_ic_play" />
      </FrameLayout>
      <FrameLayout
          android:id="@+id/widget_next"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:contentDescription="@string/music_widget_next">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_next" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
