<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/widget_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/widget_bg_default" />

  <FrameLayout
      android:id="@+id/widget_fav_top"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_gravity="top|start"
      android:contentDescription="@string/music_widget_favourite">
    <ImageView
        android:id="@+id/widget_fav_top_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:src="@drawable/widget_ic_fav" />
  </FrameLayout>

  <ImageView
      android:id="@+id/widget_brand"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:layout_gravity="top|end"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="8dp"
      android:src="@drawable/widget_ic_note" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_gravity="bottom"
      android:layout_marginBottom="10dp"
      android:gravity="center"
      android:orientation="horizontal">
    <FrameLayout
          android:id="@+id/widget_repeat"
          android:layout_width="36dp"
          android:layout_height="48dp"
          android:contentDescription="@string/music_widget_repeat">
        <ImageView
            android:id="@+id/widget_repeat_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_repeat_off" />
      </FrameLayout>
    <FrameLayout
          android:id="@+id/widget_prev"
          android:layout_width="38dp"
          android:layout_height="48dp"
          android:contentDescription="@string/music_widget_prev">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_prev" />
      </FrameLayout>
    <FrameLayout
          android:id="@+id/widget_play"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:contentDescription="@string/music_widget_play_pause">
        <ImageView
            android:id="@+id/widget_play_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_play_bg"
            android:padding="9dp"
            android:src="@drawable/widget_ic_play" />
      </FrameLayout>
    <FrameLayout
          android:id="@+id/widget_next"
          android:layout_width="38dp"
          android:layout_height="48dp"
          android:contentDescription="@string/music_widget_next">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_next" />
      </FrameLayout>
    <FrameLayout
          android:id="@+id/widget_fav"
          android:layout_width="36dp"
          android:layout_height="48dp"
          android:contentDescription="@string/music_widget_favourite">
        <ImageView
            android:id="@+id/widget_fav_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_ic_fav" />
      </FrameLayout>
  </LinearLayout>

  <ProgressBar
      android:id="@+id/widget_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="3dp"
      android:layout_gravity="bottom"
      android:layout_marginStart="10dp"
      android:layout_marginEnd="10dp"
      android:layout_marginBottom="5dp"
      android:max="1000"
      android:progress="0"
      android:progressDrawable="@drawable/widget_progress" />
</FrameLayout>
